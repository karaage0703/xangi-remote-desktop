# Explicit opt-in: leave empty until a local VNC server is configured.
REMOTE_DESKTOP_VNC_PORT=
# IPv4 loopback only. No remote destination may be supplied by a browser.
# VNC credentials are entered in the viewer and are never saved by this extension.

# Optional server-side VNC authentication (RFB 3.3/3.7/3.8, classic VNC auth).
# Password file: owner-only, 1–8 printable ASCII characters, optional final newline.
REMOTE_DESKTOP_VNC_PASSWORD_FILE=
# Absolute path; generated on first startup (0600). Also used as browser registration code.
REMOTE_DESKTOP_BROWSER_KEY_FILE=
# HTTPS default. Set false ONLY for an explicitly trusted encrypted transport such as Tailscale.
REMOTE_DESKTOP_COOKIE_SECURE=true
